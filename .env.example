# PokeArb configuration. Never commit a filled-in copy of this file.

# --- required ---------------------------------------------------------------
DATABASE_URL=postgresql://pokearb:change-me@db:5432/pokearb
REDIS_URL=redis://cache:6379/0
# The API refuses to serve without this. There is no anonymous access path.
POKEARB_API_KEY=generate-with-openssl-rand-hex-32

# --- credentials for gated sources -----------------------------------------
# Each adapter is implemented and tested. Each stays disabled until its
# credential exists AND its source row passes the compliance review.

# eBay. Marketplace Insights (sold items) is a Limited Release API requiring
# business approval and per-partner category whitelisting.
# https://developer.ebay.com/api-docs/buy/marketplace-insights/static/overview.html
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Cardmarket. Restricted to professional sellers, manual approval. A Dedicated
# App may NOT continuously poll public marketplace resources; see
# docs/01-data-sources.md before enabling anything that scans.
# https://api.cardmarket.com/ws/documentation/API:Auth_Overview
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_SECRET=
CARDMARKET_APP_TYPE=dedicated

# PSA. Cert verification only. Population data is NOT available here.
# https://www.psacard.com/publicapi/documentation
PSA_API_TOKEN=

# PriceCharting. Paid subscription, 1 call/sec, current values only.
# https://www.pricecharting.com/api-documentation
PRICECHARTING_TOKEN=

# --- alert channels ---------------------------------------------------------
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
